// Cirro executes this pipeline on AWS (Batch), so prefer S3-native reference
// sources over the public HTTPS defaults in nextflow.config -- Nextflow stages
// s3:// inputs directly from S3 rather than over the public internet, which is
// significantly faster for large reference files (e.g. the ~850MB-3GB hg38/
// hg19 FASTAs). These are the same verified paths as nextflow.config's
// params.reference_defaults_s3 (see the comments there for sourcing/
// verification notes per file), duplicated here rather than referenced --
// `params.reference_defaults = params.reference_defaults_s3` silently
// resolves to null (and hard-errors on some Nextflow versions), since this
// file is loaded via `-c` after nextflow.config and cross-file params
// references aren't reliable at that point.
//
// Only affects the *default* reference_fasta/gridss_blacklist for hg38/hg19.
// An explicit --reference_fasta supplied through the Cirro form (e.g. for
// --genome_build other, or to override the default) always takes priority.
params.reference_defaults = [
    'hg38': [
        reference_fasta      : 's3://ngi-igenomes/igenomes/Homo_sapiens/GATK/hg38/Homo_sapiens_assembly38.fasta.gz',
        gridss_blacklist     : 's3://encode-public/2020/05/05/bc5dcc02-eafb-4471-aba0-4ebc7ee8c3e6/ENCFF356LFX.bed.gz',
        gridss_resource_bundle: 'https://pub-cf6ba01919994c3cbd354659947f74d8.r2.dev/hmf_reference_data/hmftools/hmf_pipeline_resources.38_v2.3.0--2.tar.gz',
    ],
    'hg19': [
        reference_fasta      : 's3://ngi-igenomes/igenomes/Homo_sapiens/GATK/b37/human_g1k_v37_decoy.fasta.gz',
        gridss_blacklist     : 's3://encode-public/2011/05/04/f883c6e9-3ffc-4d16-813c-4c7d852d85db/ENCFF001TDObed.gz',
        gridss_resource_bundle: 'https://pub-cf6ba01919994c3cbd354659947f74d8.r2.dev/hmf_reference_data/hmftools/hmf_pipeline_resources.37_v2.3.0--2.tar.gz',
    ],
]

// Route the heaviest callers to Cirro's on-demand AWS Batch queue. Moved here
// from conf/resources.config, which broke config parsing for any non-Cirro run
// (CLI, -profile singularity/docker) because PW_ONDEMAND_JOB_QUEUE only exists
// inside Cirro's execution environment. Also corrected to use Nextflow's env()
// config accessor -- the original `"${PW_ONDEMAND_JOB_QUEUE}"` string
// interpolation was resolving a bare (undefined) Groovy variable, not the OS
// environment variable, which is what actually caused the parse error.
// Nextflow merges these withName blocks with resources.config's cpus/memory/
// time/maxRetries for the same process names, rather than replacing them.
process {
  withName: DELLY {
    queue = env('PW_ONDEMAND_JOB_QUEUE')
  }

  withName: SVABA {
    queue = env('PW_ONDEMAND_JOB_QUEUE')
  }

  withName: GRIDSS {
    queue = env('PW_ONDEMAND_JOB_QUEUE')
  }

  withName: GRIDSS_SOMATIC_FILTER_WITH_PON {
    queue = env('PW_ONDEMAND_JOB_QUEUE')
  }

  withName: GRIDSS_SOMATIC_FILTER_NO_PON {
    queue = env('PW_ONDEMAND_JOB_QUEUE')
  }
}
