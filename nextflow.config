// NASA.SV

params {
  csv = null
  publishDir = 'results'
  genome_build = 'hg38'

  genome_build_aliases = [
    'hg38'  : 'hg38',
    'grch38': 'hg38',
    '38'    : 'hg38',
    'hg19'  : 'hg19',
    'grch37': 'hg19',
    'b37'   : 'hg19',
    'hs37d5': 'hg19',
    '37'    : 'hg19',
    'other' : 'other',
  ]

  reference_defaults = [
    'hg38': [
      reference_fasta      : 'https://ftp.1000genomes.ebi.ac.uk/vol1/ftp/technical/reference/GRCh38_reference_genome/GRCh38_full_analysis_set_plus_decoy_hla.fa',
      gridss_blacklist     : 'https://www.encodeproject.org/files/ENCFF356LFX/@@download/ENCFF356LFX.bed.gz',
      gridss_resource_bundle: 'https://storage.googleapis.com/hmf-public/HMFtools-Resources/pipeline/oncoanalyser/2.3/38/hmf_pipeline_resources.38_v2.3.0--2.tar.gz',
    ],
    'hg19': [
      reference_fasta      : 'https://ftp.1000genomes.ebi.ac.uk/vol1/ftp/technical/reference/phase2_reference_assembly_sequence/hs37d5.fa.gz',
      gridss_blacklist     : 'https://www.encodeproject.org/files/ENCFF001TDO/@@download/ENCFF001TDO.bed.gz',
      gridss_resource_bundle: 'https://storage.googleapis.com/hmf-public/HMFtools-Resources/pipeline/oncoanalyser/2.3/37/hmf_pipeline_resources.37_v2.3.0--2.tar.gz',
    ],
  ]

  // S3-native mirrors of the same reference_defaults, for use on AWS (Batch/Cirro)
  // where s3:// transfer is much faster than the public HTTPS endpoints above.
  // Sources verified directly against the live buckets (aws s3 ls --no-sign-request)
  // and the ENCODE portal API (s3_uri field), not guessed:
  //  - hg38 FASTA: AWS iGenomes GATK/hg38 bundle (Homo_sapiens_assembly38.fasta.gz) --
  //    chr-prefixed naming, same convention as the HTTPS default above.
  //  - hg19 FASTA: AWS iGenomes GATK/b37 bundle (human_g1k_v37_decoy.fasta.gz), NOT
  //    iGenomes' GATK/hg19 folder (ucsc.hg19.fasta.gz) -- the ucsc.hg19 file uses
  //    chr-prefixed contigs and no decoy sequence, a different convention than the
  //    bare-number/decoy hs37d5 this pipeline defaults to. human_g1k_v37_decoy
  //    matches hs37d5's naming convention (same underlying GRCh37+decoy build).
  //  - GRIDSS blacklists: exact s3_uri from https://www.encodeproject.org/files/<ACCESSION>/?format=json
  //  - gridss_resource_bundle: no S3 mirror exists for this file. It IS
  //    mirrored on Cloudflare R2 (zero egress fees, CDN-backed) by nf-core/
  //    oncoanalyser itself as of its current release -- same version
  //    (v2.3.0--2) and filename as the GCS copy, confirmed via
  //    `gh search code HMF_DATA_38_PATH repo:nf-core/oncoanalyser`
  //    (lib/Constants.groovy) and verified live with `curl -I` (HTTP 200).
  //    Using that R2 URL here since it's not literally s3:// but should still
  //    outperform storage.googleapis.com from AWS compute.
  reference_defaults_s3 = [
    'hg38': [
      reference_fasta      : 's3://ngi-igenomes/igenomes/Homo_sapiens/GATK/hg38/Homo_sapiens_assembly38.fasta.gz',
      gridss_blacklist     : 's3://encode-public/2020/05/05/bc5dcc02-eafb-4471-aba0-4ebc7ee8c3e6/ENCFF356LFX.bed.gz',
      gridss_resource_bundle: 'https://pub-cf6ba01919994c3cbd354659947f74d8.r2.dev/hmf_reference_data/hmftools/hmf_pipeline_resources.38_v2.3.0--2.tar.gz',
    ],
    'hg19': [
      reference_fasta      : 's3://ngi-igenomes/igenomes/Homo_sapiens/GATK/b37/human_g1k_v37_decoy.fasta.gz',
      gridss_blacklist     : 's3://encode-public/2011/05/04/f883c6e9-3ffc-4d16-813c-4c7d852d85db/ENCFF001TDObed.gz',
      gridss_resource_bundle: 'https://pub-cf6ba01919994c3cbd354659947f74d8.r2.dev/hmf_reference_data/hmftools/hmf_pipeline_resources.37_v2.3.0--2.tar.gz',
    ],
  ]

  default_gridss_properties = 'https://raw.githubusercontent.com/PapenfussLab/gridss/825bc8e1bb092e9bb2ccb0c1c51dc6e7e1a922dd/src/main/resources/gridss.properties'

  reference_fasta = null
  reference_index = null
  gridss_blacklist = null
  gridss_properties = null
  gridss_sv_pon = null
  gridss_sgl_pon = null
  gridss_resource_bundle = null

  run_manta = true
  run_lumpy = true
  run_svaba = true
  run_delly = true
  run_gridss = true

  // null => default to the count of enabled callers (n/n consensus).
  // Set explicitly to require agreement from fewer than all enabled callers.
  consensus_min_support = null
}

profiles {

  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
  }

  docker {
    docker.enabled = true
    docker.autoMounts = true
  }

  test {
    params.csv = "${projectDir}/test.csv"
    params.publishDir = "${projectDir}/test/result/"
  }

  bundle_paths {
    params.genome_build = 'hg38'
    params.reference_fasta = "${projectDir}/data/ref1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa"
    params.reference_index = "${projectDir}/data/ref1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa.fai"
    params.gridss_blacklist = "${projectDir}/data/gridsspl/gpl_ref_gatk_38/dbs/gridss/ENCFF001TDO.bed"
    params.gridss_properties = "${projectDir}/data/gridsspl/gpl_ref_gatk_38/dbs/gridss/gridss.properties"
  }

  // Use S3-native sources for the built-in hg38/hg19 defaults instead of the
  // public HTTPS endpoints -- much faster when compute is already running in
  // AWS (e.g. Batch/Cirro), since Nextflow stages s3:// inputs directly from
  // S3 rather than downloading over the public internet. Only affects the
  // *default* reference_fasta/gridss_blacklist for hg38/hg19; an explicit
  // --reference_fasta (e.g. for --genome_build other) always takes priority
  // regardless of this profile. See reference_defaults_s3 above for sourcing
  // notes on each individual path.
  s3 {
    params.reference_defaults = params.reference_defaults_s3
  }

}
includeConfig 'conf/resources.config'
